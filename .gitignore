# ==========================================
# .gitignore - Projeto SolAgora QA Automation
# ==========================================

# 1. Ambientes Virtuais (Essencial para não subir bibliotecas pesadas)
.venv/
venv/
env/

# 2. Arquivos de Cache do Python e Pytest
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 3. Relatórios e Evidências (Allure)
# allure-results/ — NÃO ignorado: developer commita após rodar localmente
#                   CI usa esses arquivos para gerar e publicar o relatório
allure-report/    # HTML gerado — ignorado (CI gera na hora)

# 4. Logs e Variáveis de Ambiente
*.log
.env

# 5. Playwright e outros
test-results/
*.webm
# Claude Code local settings
.claude/settings.local.json
utils/.token_hml

# 6. Build artifacts e temporários
build/
dist/
temp_*.png
temp_evid_*.png
evidencias_manuais/
*.spec
